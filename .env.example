POSTGRES_PRISMA_URL=postgresql://postgres:1234@localhost
POSTGRES_URL_NON_POOLING=postgresql://postgres:1234@localhost

# Public URL this instance is reachable at. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Default currency pre-selected when creating a new group. Defaults to USD.
# DEFAULT_CURRENCY_CODE=EUR

# Opt-in features — uncomment to enable. See the README for what each needs.

# Attach images to expenses (requires S3 storage):
# ENABLE_EXPENSE_DOCUMENTS=true
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=
# S3_UPLOAD_ENDPOINT=       # only needed for non-AWS S3 providers

# Attach images to expenses. Images are stored on local disk (no S3 needed).
# ENABLE_EXPENSE_DOCUMENTS=true
# UPLOAD_DIR=./uploads

# Create expenses by scanning receipts. Needs a vision-capable, OpenAI-compatible
# model that supports structured outputs (json_schema).
# ENABLE_RECEIPT_EXTRACT=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_RECEIPT_EXTRACT=gpt-5-nano

# Auto-suggest the expense category from its title (requires OpenAI):
# ENABLE_CATEGORY_EXTRACT=true
# OPENAI_API_KEY=

# AI provider options for the receipt and category features (see the README).
# Any OpenAI-compatible endpoint works; the default is the official OpenAI API.
# OPENAI_BASE_URL=          # e.g. https://evren-llmapi.ssyz.org.tr/v1
# OPENAI_MODEL_RECEIPT_EXTRACT=gemma-4-31b
# OPENAI_MODEL_CATEGORY_EXTRACT=gemma-4-31b

# Analytics is disabled unless a provider is selected. See the README.
# ANALYTICS_PROVIDER=console
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_DOMAIN=your-domain.com
